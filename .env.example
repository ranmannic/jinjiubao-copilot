# Server
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=development
LOG_LEVEL=INFO

# LLM — Moonshot/Kimi 或 DeepSeek（OpenAI 兼容 SDK）
# DeepSeek V4 Flash（推荐性价比）:
# LLM_ENABLED=true
# LLM_API_KEY=sk-your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash
# 注意：不要用 /anthropic 端点，那是 Claude SDK 专用

# Moonshot 国内 Key（platform.moonshot.cn）:
LLM_ENABLED=true
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=moonshot-v1-8k
# 国际 Key（platform.kimi.ai）: LLM_BASE_URL=https://api.moonshot.ai/v1  LLM_MODEL=kimi-k2.6

# 进酒宝 SaaS integration
JINJIUBAO_API_BASE_URL=https://api.jinjiubao.example.com
JINJIUBAO_API_KEY=
JINJIUBAO_API_TIMEOUT=15

# Session storage: memory | redis | sqlite
SESSION_BACKEND=sqlite
REDIS_URL=redis://localhost:6379/0
SQLITE_PATH=./data/sessions.db

# Handoff
HANDOFF_INTENT_THRESHOLD=70
SALES_CALLBACK_SLA_MINUTES=30
